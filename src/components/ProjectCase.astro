---
import { ArrowUpRight } from '@lucide/astro';

interface Detail {
  label: string;
  value: string;
}

interface Link {
  label: string;
  href: string;
}

interface Props {
  index: string;
  category: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  details: Detail[];
  links: Link[];
  imagePosition?: 'left' | 'right';
}

const { index, category, title, summary, image, imageAlt, details, links, imagePosition = 'right' } = Astro.props;
---

<article class="border-t border-line py-12 md:py-16 lg:py-20">
  <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
    <div class:list={['lg:col-span-5', imagePosition === 'left' && 'lg:order-2']}>
      <div class="mb-8 flex items-center gap-3 font-mono text-xs uppercase text-muted">
        <span class="text-accent">{index}</span>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </div>
      <h3 class="text-4xl font-semibold leading-[1.05] md:text-5xl">{title}</h3>
      <p class="mt-5 max-w-xl text-lg leading-8 text-muted">{summary}</p>

      <dl class="mt-10 divide-y divide-line border-y border-line">
        {details.map((detail) => (
          <div class="grid grid-cols-[7rem_1fr] gap-4 py-4 text-sm md:grid-cols-[8rem_1fr]">
            <dt class="font-mono text-xs uppercase text-muted">{detail.label}</dt>
            <dd class="leading-6 text-ink">{detail.value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
        {links.map((link) => (
          <a class="text-link" href={link.href} target="_blank" rel="noreferrer">
            {link.label}
            <ArrowUpRight size={16} stroke-width={1.8} />
          </a>
        ))}
      </div>
    </div>

    <a
      href={links[0]?.href}
      target="_blank"
      rel="noreferrer"
      class:list={['group block overflow-hidden border border-line bg-surface lg:col-span-7', imagePosition === 'left' && 'lg:order-1']}
      aria-label={`Open ${title}`}
    >
      <div class="flex h-10 items-center justify-between border-b border-line px-4 font-mono text-[11px] text-muted">
        <span>Production / live system</span>
        <span>↗</span>
      </div>
      <img src={image} alt={imageAlt} width="1272" height="716" loading="lazy" class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" />
    </a>
  </div>
</article>
