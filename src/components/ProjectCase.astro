---
import { ArrowUpRight } from '@lucide/astro';

interface Detail {
  label: string;
  value: string;
}

interface Link {
  label: string;
  href: string;
}

interface Props {
  index: string;
  category: string;
  title: string;
  summary: string;
  details: Detail[];
  links: Link[];
}

const { index, category, title, summary, details, links } = Astro.props;
---

<article class="border-t border-line py-12 md:py-16 lg:py-20">
  <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <div class="mb-8 flex items-center gap-3 font-mono text-xs uppercase text-muted">
        <span class="text-accent">{index}</span>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </div>
      <h3 class="text-4xl font-semibold leading-[1.05] md:text-5xl">{title}</h3>
      <p class="mt-5 max-w-xl text-lg leading-8 text-muted">{summary}</p>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
        {links.map((link) => (
          <a class="text-link" href={link.href} target="_blank" rel="noreferrer">
            {link.label}
            <ArrowUpRight size={16} stroke-width={1.8} />
          </a>
        ))}
      </div>
    </div>

    <dl class="grid border-l border-t border-line md:grid-cols-2 lg:col-span-8">
      {details.map((detail) => (
        <div class="min-h-52 border-b border-r border-line p-6 md:p-8">
          <dt class="font-mono text-xs uppercase text-accent">{detail.label}</dt>
          <dd class="mt-6 max-w-xl text-lg font-medium leading-8 text-ink">{detail.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</article>
