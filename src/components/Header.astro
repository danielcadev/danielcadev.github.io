---
import { GitBranch, Mail, Moon, Sun } from '@lucide/astro';
---

<header class="sticky top-0 z-50 border-b border-line bg-page/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 w-full max-w-[1440px] items-center justify-between px-5 md:px-8 lg:px-12">
    <a href="#top" class="font-mono text-xs font-medium uppercase text-ink no-underline">
      DC / Engineering
    </a>

    <div class="flex items-center gap-2 md:gap-6">
      <nav aria-label="Primary navigation" class="hidden items-center gap-6 md:flex">
        <a class="nav-link" href="#work">Work</a>
        <a class="nav-link" href="#approach">Approach</a>
        <a class="nav-link" href="#open-source">Open source</a>
        <a class="nav-link" href="#about">About</a>
      </nav>

      <div class="flex items-center gap-1 border-l border-line pl-2 md:pl-4">
        <a class="icon-button" href="https://github.com/danielcadev" target="_blank" rel="noreferrer" aria-label="GitHub profile" title="GitHub profile">
          <GitBranch size={18} stroke-width={1.8} />
        </a>
        <a class="icon-button" href="mailto:daniel.ca.pe207@gmail.com" aria-label="Email Daniel" title="Email Daniel">
          <Mail size={18} stroke-width={1.8} />
        </a>
        <button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle color theme" title="Toggle color theme">
          <Moon class="theme-moon" size={18} stroke-width={1.8} />
          <Sun class="theme-sun" size={18} stroke-width={1.8} />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

  toggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
  });
</script>
